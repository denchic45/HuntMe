{
  "id": "huntme",
  "realm": "huntme",
  "displayName": "HuntMe Recruiting Platform",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "candidate",
        "description": "Candidate role for HuntMe"
      },
      {
        "name": "employer",
        "description": "Employer role for HuntMe"
      }
    ]
  },
  "clients": [
    {
      "clientId": "huntme-api",
      "name": "HuntMe Backend API",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "huntme-frontend",
      "name": "HuntMe Frontend Client",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "huntme-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "huntme-api",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "candidate@huntme.dev",
      "email": "candidate@huntme.dev",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Алексей",
      "lastName": "Голубев",
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "candidate"
      ],
      "attributes": {
        "role": [
          "candidate"
        ],
        "city": [
          "Москва"
        ],
        "age": [
          "24"
        ]
      }
    },
    {
      "username": "employer@huntme.dev",
      "email": "employer@huntme.dev",
      "enabled": true,
      "emailVerified": true,
      "firstName": "HR",
      "lastName": "Менеджер",
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "employer"
      ],
      "attributes": {
